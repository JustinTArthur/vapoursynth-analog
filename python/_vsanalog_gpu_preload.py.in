"""Preload pip-installed GPU vendor runtimes for the vsanalog GPU wheel.

Generated by Meson and installed, by GPU wheel variants only, at the
site-packages root: the vsanalog plugin's accelerated ONNX Runtime execution
providers resolve the vendor runtime (CUDA, cuDNN, TensorRT) through the
dynamic loader, which knows nothing about the site-packages/nvidia/* and
tensorrt_libs directories pip installs it to. Loading those libraries here,
leaves first, lets every later load find them by name with no
LD_LIBRARY_PATH/PATH involvement.

The accompanying vsanalog_gpu.pth runs preload() at interpreter startup so a
with_cuda plugin's own link-time CUDA dependencies resolve before
VapourSynth's autoloader touches it; vsanalog's __init__ calls it again
(harmlessly) for interpreters that skip site processing. The plugin performs
the same resolution natively at session creation as a final fallback.

Per library: anything already loaded in the process wins (never load a second
copy of a soname); then the pip copy by full path; then a plain name lookup,
which honours LD_LIBRARY_PATH, ldconfig and PATH exactly as a system runtime
install expects. VSANALOG_GPU_RUNTIME=system skips the pip step;
VSANALOG_GPU_RUNTIME=off disables preloading entirely.
"""

_GPU_RUNTIME = "@VSA_GPU_RUNTIME@"
_PRELOAD_TABLE = @VSA_GPU_PRELOAD_TABLE_PY@

# Families a vendor loader shim dlopens by bare soname at first use (cuDNN 9's
# engines). Deliberately NOT loaded here: nothing links them, so no plugin load
# depends on them, and mapping the cuDNN family costs ~170 MB of RSS that every
# unrelated interpreter in the environment would otherwise pay. The plugin
# resolves them natively when an accelerated backend is actually used. Exported
# so tools/check_gpu_preload_table.py can check the table against a real pip
# layout, which is the only place the omission would ever show up.
_DLOPEN_TABLE = @VSA_GPU_DLOPEN_TABLE_PY@

# soname/DLL name -> "resident" | loaded path | "system"; unresolved names go
# to _missing. Kept for diagnosis (python -c "import _vsanalog_gpu_preload;
# ...preload(); print(...._loaded)") since this can run before any logging is
# configured.
_loaded = {}
_missing = []
_handles = []
_done = False


def _mode():
    import os

    value = os.environ.get("VSANALOG_GPU_RUNTIME", "").strip().lower()
    if value in ("off", "none", "0", "disabled"):
        return "off"
    if value == "system":
        return "system"
    return "auto"


def _site_roots():
    """Site-packages roots that may hold the nvidia/tensorrt_libs packages.

    This module sits at a site-packages root itself, which covers the normal
    single-environment install; the nvidia namespace package's search
    locations cover split site-packages (user-site, .pth-extended paths).
    """
    from pathlib import Path

    roots = [Path(__file__).resolve().parent]
    try:
        import importlib.util

        spec = importlib.util.find_spec("nvidia")
        for location in getattr(spec, "submodule_search_locations", None) or []:
            parent = Path(location).resolve().parent
            if parent not in roots:
                roots.append(parent)
    except Exception:
        pass
    return roots


def _add_to_path(directory):
    """Put a vendor directory on the process PATH (Windows only).

    os.add_dll_directory covers loads that opt into LOAD_LIBRARY_SEARCH_*,
    which a vendor library's own helpers need not do: TensorRT loads
    nvinfer_builder_resource_sm<arch>_10.dll — the per-architecture kernel
    resource its builder needs, ~170 MB, one of eight, so not preloadable
    from the table — through a plain LoadLibrary by bare name at engine build
    time. That search reads PATH, which is how a normal TensorRT install
    advertises its lib directory, and without it engine building fails with
    "Unable to load library: nvinfer_builder_resource_sm86_10.dll: 126".
    """
    import os

    current = os.environ.get("PATH", "")
    if directory.lower() in (p.lower() for p in current.split(os.pathsep)):
        return
    os.environ["PATH"] = directory + os.pathsep + current if current else directory


def preload():
    global _done
    if _done:
        return
    _done = True

    mode = _mode()
    if mode == "off" or not _PRELOAD_TABLE:
        return

    import ctypes
    import os
    import sys

    windows = sys.platform == "win32"
    if windows:
        kernel32 = ctypes.windll.kernel32
    roots = _site_roots()
    dll_dir_handles = []

    for name, rel_dirs in _PRELOAD_TABLE:
        # Already mapped into the process (the plugin's own link-time
        # dependencies, or a co-resident consumer like torch): loading a
        # second copy by path would put two libraries with one name in the
        # process, so whatever is resident wins.
        try:
            if windows:
                if kernel32.GetModuleHandleW(name):
                    _loaded[name] = "resident"
                    continue
            elif hasattr(os, "RTLD_NOLOAD"):
                try:
                    ctypes.CDLL(name, mode=os.RTLD_NOLOAD | os.RTLD_LAZY)
                    _loaded[name] = "resident"
                    continue
                except OSError:
                    pass
        except Exception:
            pass

        handle = None
        if mode != "system":
            for root in roots:
                for rel_dir in rel_dirs:
                    path = root.joinpath(*rel_dir.split("/")) / name
                    if not path.is_file():
                        continue
                    try:
                        if windows:
                            # Registered so a library's dynamically loaded
                            # helpers (cuDNN's submodules) resolve too.
                            dll_dir_handles.append(
                                os.add_dll_directory(str(path.parent))
                            )
                            _add_to_path(str(path.parent))
                            handle = ctypes.WinDLL(str(path))
                        else:
                            handle = ctypes.CDLL(
                                str(path), mode=os.RTLD_NOW | os.RTLD_GLOBAL
                            )
                        _loaded[name] = str(path)
                    except OSError:
                        handle = None
                    break
                if handle is not None or name in _loaded:
                    break

        if handle is None and name not in _loaded:
            try:
                if windows:
                    # winmode=0 is the classic search order, which includes
                    # PATH; ctypes' default since Python 3.8 does not, and a
                    # toolkit install advertises itself through PATH alone.
                    handle = ctypes.WinDLL(name, winmode=0)
                else:
                    handle = ctypes.CDLL(name, mode=os.RTLD_NOW | os.RTLD_GLOBAL)
                _loaded[name] = "system"
            except OSError:
                _missing.append(name)

        if handle is not None:
            _handles.append(handle)

    # The directory registrations must outlive this call for later lazy
    # loads; pin them alongside the library handles.
    _handles.extend(dll_dir_handles)
