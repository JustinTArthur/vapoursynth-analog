[wrap-git]
url = https://github.com/JustinTArthur/libchromadec.git
revision = 07bf64a1462b0a5cf04bd6a730950fbcfa5f0efc

# libchromadec calls meson.override_dependency('chromadec', ...), so
# dependency('chromadec') resolves to this subproject with no install step.
# Pinned to a commit for reproducibility; move to the '0.1.0' tag once upstream
# cuts it (freezes the ABI).
[provide]
dependency_names = chromadec
