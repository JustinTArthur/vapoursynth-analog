/******************************************************************************
 * gpupreload_config.h — generated by Meson from src/gpupreload_config.h.in
 *
 * The wheel variant's vendor runtime library table: each entry is the
 * platform's soname/DLL name plus the site-packages-relative directories the
 * pip packages place it in, leaves-first so every later library's dependency
 * on an earlier one is satisfied by the copy already loaded. Majors are baked
 * in because the bundled ONNX Runtime pins them; the Python-side table in
 * _vsanalog_gpu_preload.py is generated from the same Meson data.
 *
 * The dlopen table holds families a vendor loader shim opens by bare soname
 * at runtime (cuDNN 9's engines). Same shape, but only this plugin loads
 * them, and only once an accelerated backend is in play — they are large and
 * nothing links them, so the startup preload leaves them alone.
 *
 * SPDX-License-Identifier: GPL-3.0-or-later
 ******************************************************************************/

#ifndef GPUPRELOAD_CONFIG_H
#define GPUPRELOAD_CONFIG_H

#define VSA_GPU_RUNTIME "@VSA_GPU_RUNTIME@"
#define VSA_GPU_PRELOAD_TABLE @VSA_GPU_PRELOAD_TABLE@
#define VSA_GPU_DLOPEN_TABLE @VSA_GPU_DLOPEN_TABLE@

#endif  // GPUPRELOAD_CONFIG_H
